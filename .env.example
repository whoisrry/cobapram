# Cara termudah: `make env` (mengisi IP server dan semua secret secara acak).
# Manual: salin ke .env lalu isi nilai yang kosong (openssl rand -hex 32).
# Jangan commit .env.

# production | development
APP_ENV=production

# Alamat aplikasi: IP server (misalnya 10.0.0.5) atau hostname.
SITE_ADDRESS=
# Default: sertifikat dari CA internal Caddy (tanpa Let's Encrypt).
# Isi email (CADDY_TLS=admin@example.com) hanya jika SITE_ADDRESS berupa domain
# publik dan ingin memakai Let's Encrypt.
CADDY_TLS=internal

# --- PostgreSQL ---
# DB_HOST dan DB_PORT di-override oleh docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=ticketing
DB_PASSWORD=
DB_NAME=ticketing
# disable aman karena koneksi hanya lewat jaringan internal Docker.
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_QUERY_TIMEOUT=5s

# --- Redis ---
# REDIS_ADDR di-override oleh docker-compose.yml.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT (HS256) ---
JWT_SECRET=
# Sebaiknya sama dengan https://<SITE_ADDRESS>
JWT_ISSUER=
JWT_AUDIENCE=ticketing-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# --- CSRF --- (harus berbeda dari JWT_SECRET)
CSRF_KEY=

# true wajib di production. false hanya untuk development tanpa HTTPS.
COOKIE_SECURE=true

# --- Rate limit login per IP ---
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=15m

# --- OpenTelemetry (backend + browser -> Jaeger) ---
# OTEL_EXPORTER_OTLP_ENDPOINT di-override oleh docker-compose.yml (http://jaeger:4318).
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ticketing-app

# Salin ke .env lalu isi semua nilai yang kosong. Jangan commit .env.
# Buat secret acak dengan: openssl rand -hex 32

# production | development
APP_ENV=production

# Domain publik untuk Caddy (TLS otomatis). Untuk lokal: localhost
SITE_ADDRESS=tiket.example.com

# --- PostgreSQL ---
# DB_HOST dan DB_PORT di-override oleh docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=ticketing
DB_PASSWORD=
DB_NAME=ticketing
# disable aman karena koneksi hanya lewat jaringan internal Docker.
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_QUERY_TIMEOUT=5s

# --- Redis ---
# REDIS_ADDR di-override oleh docker-compose.yml.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT (HS256) ---
JWT_SECRET=
JWT_ISSUER=https://tiket.example.com
JWT_AUDIENCE=ticketing-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# --- CSRF --- (harus berbeda dari JWT_SECRET)
CSRF_KEY=

# true wajib di production. false hanya untuk development tanpa HTTPS.
COOKIE_SECURE=true

# --- Rate limit login per IP ---
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=15m

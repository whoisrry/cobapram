{
	# Browser tidak mengirim SNI saat diakses lewat alamat IP, jadi Caddy
	# perlu tahu sertifikat mana yang dipakai untuk koneksi tanpa SNI.
	default_sni {$SITE_ADDRESS}

	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
}

{$SITE_ADDRESS} {
	# Default "internal": sertifikat dari CA lokal Caddy (self-signed), tanpa
	# Let's Encrypt/ZeroSSL. Bisa dipakai untuk alamat IP maupun hostname.
	# Untuk domain publik dengan Let's Encrypt: set CADDY_TLS=email@domain di .env.
	tls {$CADDY_TLS:internal}

	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header -Server

	# Span dari browser (/static/otel.js) diteruskan ke Jaeger (OTLP/HTTP).
	# Hanya POST ke satu path ini; port OTLP Jaeger tidak dibuka ke publik.
	handle /otel/v1/traces {
		@notPost not method POST
		respond @notPost 405

		request_body {
			max_size 512KB
		}
		uri strip_prefix /otel
		reverse_proxy jaeger:4318
	}

	handle {
		reverse_proxy app:8080
	}

	log
}
